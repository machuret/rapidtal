NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-...
APIFY_API_KEY=apify_api_...
APIFY_INGEST_MAX_CHARGE_USD=1
APIFY_COMPANY_MAX_CHARGE_USD=1
APIFY_COMPANY_RESOLVE_MAX_CHARGE_USD=0.25
APIFY_COMPANY_SEARCH_COUNTRY=au
# Optional Phase 3 actor overrides: creator~actor-name
APIFY_COMPANY_SEARCH_ACTOR=apify~google-search-scraper
APIFY_WEBSITE_CONTENT_ACTOR=apify~website-content-crawler
OPENAI_COMPANY_MODEL=gpt-4o-mini
# Override these when OPENAI_COMPANY_MODEL changes.
OPENAI_COMPANY_INPUT_USD_PER_MILLION=0.15
OPENAI_COMPANY_OUTPUT_USD_PER_MILLION=0.60
# Optional Phase 2 actor overrides: creator~actor-name
APIFY_SEEK_ACTOR=
APIFY_INDEED_ACTOR=
APIFY_LINKEDIN_ACTOR=
APIFY_DISCOVERY_MAX_CHARGE_USD=1
# Used by the separate company-DNA and vault crawlers.
FIRECRAWL_API_KEY=fc-...
